FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.27.3 AS builder

WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY api/ api/
COPY internal/ internal/
ARG TARGETARCH
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_DATE=unknown
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -a \
      -ldflags "-s -w \
        -X github.com/yboikov/voxkube-operator/internal/version.Version=${VERSION} \
        -X github.com/yboikov/voxkube-operator/internal/version.Commit=${COMMIT} \
        -X github.com/yboikov/voxkube-operator/internal/version.BuildDate=${BUILD_DATE}" \
      -o manager ./cmd/main.go

FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8-1794186349

ARG VERSION=dev
LABEL org.opencontainers.image.title="VoxKube Operator" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.description="VoxKube - OpenShift and Kubernetes-native Operator for OpenVox and Puppet" \
      org.opencontainers.image.vendor="yboikov" \
      org.opencontainers.image.url="https://github.com/yboikov/voxkube-operator" \
      org.opencontainers.image.source="https://github.com/yboikov/voxkube-operator" \
      org.opencontainers.image.licenses="Apache-2.0"

COPY --from=builder /workspace/manager /manager

USER 1001:0

ENTRYPOINT ["/manager"]
