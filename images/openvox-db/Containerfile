# Stage 1: Install OpenVox DB from official Vox Pupuli RPM repository
FROM --platform=$BUILDPLATFORM registry.access.redhat.com/ubi9/ubi:latest AS rpm-installer
# Pinned version. Bump it together with internal/controller/versions.go and the chart (Renovate does this).
ARG OPENVOXDB_VERSION=8.15.0
RUN dnf install -y https://yum.voxpupuli.org/openvox8-release-el-9.noarch.rpm && \
    dnf install -y --setopt=install_weak_deps=False "openvoxdb-${OPENVOXDB_VERSION}" && \
    rpm -q openvoxdb | tee /openvox-packages.txt && \
    rpm -q --qf '%{VERSION}' openvoxdb | grep -qx "${OPENVOXDB_VERSION}" && \
    dnf clean all

# Stage 2: Rootless OpenShift restricted-v2 runtime image
FROM registry.access.redhat.com/ubi9/ubi:latest
ARG JDK_VERSION=21

ARG OPENVOXDB_VERSION=8.15.0
LABEL org.opencontainers.image.title="VoxKube OpenVox DB" \
      org.opencontainers.image.version="${OPENVOXDB_VERSION}" \
      org.opencontainers.image.description="Rootless OpenVox DB (PuppetDB) for Kubernetes and OpenShift" \
      org.opencontainers.image.vendor="yboikov" \
      org.opencontainers.image.url="https://github.com/yboikov/voxkube-operator" \
      org.opencontainers.image.source="https://github.com/yboikov/voxkube-operator" \
      org.opencontainers.image.licenses="Apache-2.0"

RUN dnf install -y --allowerasing --setopt=install_weak_deps=False \
        java-${JDK_VERSION}-openjdk-headless \
        bash \
        curl \
        openssl \
        findutils \
        hostname && \
    dnf clean all

ENV JAVA_ARGS="-Xms256m -Xmx512m" \
    HOME=/opt/puppetlabs/server/data/puppetdb \
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/opt/puppetlabs/server/bin:/opt/puppetlabs/puppet/bin:/opt/puppetlabs/bin

COPY --from=rpm-installer /opt/puppetlabs /opt/puppetlabs
COPY --from=rpm-installer /etc/puppetlabs /etc/puppetlabs
COPY --from=rpm-installer /var/log/puppetlabs /var/log/puppetlabs
COPY --from=rpm-installer /var/run/puppetlabs /var/run/puppetlabs
COPY --from=rpm-installer /openvox-packages.txt /usr/share/voxkube/openvox-packages.txt

COPY images/openvox-db/entrypoint.sh /entrypoint.sh

RUN printf '%s\n' \
    '<configuration debug="false">' \
    '  <appender name="STDOUT" class="ch.qos.logback.access.common.ConsoleAppender">' \
    '    <encoder><pattern>%h %l %u [%t] "%r" %s %b "%i{Referer}" "%i{User-Agent}" %D</pattern></encoder>' \
    '  </appender>' \
    '  <appender-ref ref="STDOUT" />' \
    '</configuration>' > /etc/puppetlabs/puppetdb/request-logging.xml && \
    chmod +x /entrypoint.sh && \
    for d in /etc/puppetlabs /var/log/puppetlabs /var/run/puppetlabs /opt/puppetlabs; do \
        chgrp -R 0 "$d"; \
        chmod -R g=u "$d"; \
        find "$d" -type d -exec chmod g+s {} +; \
    done

USER 1001:0
EXPOSE 8080 8081
ENTRYPOINT ["/entrypoint.sh"]
