# Stage 1: Build g10k binary for Git environment synchronization
FROM docker.io/library/golang:1.24 AS g10k-builder
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go install github.com/xorpaul/g10k@latest

# Stage 2: Install OpenVox Server from official Vox Pupuli RPM repository
FROM registry.access.redhat.com/ubi9/ubi:latest AS rpm-installer
RUN dnf install -y https://yum.voxpupuli.org/openvox8-release-el-9.noarch.rpm && \
    dnf install -y --setopt=install_weak_deps=False openvox-server && \
    dnf clean all

# Stage 3: Rootless OpenShift restricted-v2 runtime image
FROM registry.access.redhat.com/ubi9/ubi:latest
ARG JDK_VERSION=21

LABEL org.opencontainers.image.title="VoxKube OpenVox Server" \
      org.opencontainers.image.description="Rootless OpenVox Server and CA for Kubernetes and OpenShift" \
      org.opencontainers.image.vendor="yboikov" \
      org.opencontainers.image.url="https://github.com/yboikov/voxkube-operator" \
      org.opencontainers.image.source="https://github.com/yboikov/voxkube-operator" \
      org.opencontainers.image.licenses="Apache-2.0"

RUN dnf install -y --allowerasing --setopt=install_weak_deps=False \
        java-${JDK_VERSION}-openjdk-headless \
        bash \
        curl \
        git \
        openssl \
        tar \
        gzip \
        findutils \
        hostname && \
    dnf clean all

ENV LOGDIR=/var/log/puppetlabs/puppetserver \
    OPENVOXSERVER_MAX_ACTIVE_INSTANCES=1 \
    OPENVOXSERVER_MAX_REQUESTS_PER_INSTANCE=0 \
    JAVA_ARGS="-Xms512m -Xmx512m" \
    HOME=/opt/puppetlabs/server/data/puppetserver \
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/opt/puppetlabs/server/bin:/opt/puppetlabs/puppet/bin:/opt/puppetlabs/bin

COPY --from=g10k-builder /go/bin/g10k /usr/local/bin/g10k
COPY --from=rpm-installer /opt/puppetlabs /opt/puppetlabs
COPY --from=rpm-installer /etc/puppetlabs /etc/puppetlabs
COPY --from=rpm-installer /var/log/puppetlabs /var/log/puppetlabs
COPY --from=rpm-installer /var/run/puppetlabs /var/run/puppetlabs

COPY images/openvox-server/entrypoint.sh /entrypoint.sh

RUN printf '%s\n' \
    '<configuration debug="false">' \
    '  <appender name="STDOUT" class="ch.qos.logback.access.common.ConsoleAppender">' \
    '    <encoder><pattern>%h %l %u [%t] "%r" %s %b "%i{Referer}" "%i{User-Agent}" %D</pattern></encoder>' \
    '  </appender>' \
    '  <appender-ref ref="STDOUT" />' \
    '</configuration>' > /etc/puppetlabs/puppetserver/request-logging.xml && \
    printf '%s\n' \
    '#!/bin/sh' \
    'set -e' \
    'while true; do /usr/local/bin/g10k "$@"; sleep 60; done' > /usr/local/bin/g10k-sidecar && \
    chmod +x /entrypoint.sh /usr/local/bin/g10k /usr/local/bin/g10k-sidecar && \
    mkdir -p /var/cache/puppetlabs ${HOME}/.puppetlabs/var && \
    ln -sf /etc/puppetlabs ${HOME}/.puppetlabs/etc && \
    ln -sf /opt/puppetlabs ${HOME}/.puppetlabs/opt && \
    ln -sf /var/log/puppetlabs ${HOME}/.puppetlabs/var/log && \
    ln -sf /var/run/puppetlabs ${HOME}/.puppetlabs/var/run && \
    for d in /etc/puppetlabs /var/cache/puppetlabs /var/log/puppetlabs /var/run/puppetlabs /opt/puppetlabs; do \
        chgrp -R 0 "$d"; \
        chmod -R g=u "$d"; \
        find "$d" -type d -exec chmod g+s {} +; \
    done

USER 1001:0
EXPOSE 8140
ENTRYPOINT ["/entrypoint.sh"]
